/* The management menus: frosted glass with broadcast type, laid out on a 1600 x 900 reference screen.
   Every screen is built from the pieces in MenuKit.cs, styled once here. Fonts are set from code.
   Glass blur, sheen and shadows are drawn by MenuGlass.cs.

   Type: 12px small caps labels, 13px column heads, 15px rows, 26px names, 46px big numbers.
   Text: white, muted at 62%, dim at 42%. Money and good values in green, bad in red, middling in amber.
   Corners: 12px for rows, tiles and small buttons, 20px for buttons and insets, 24px for panels.
   Translucent colours: UI Toolkit blends in linear light, so each alpha is lower or higher than the look it gives (muted
   text is 39%, which shows as 62% blended in sRGB did). Pick a colour's alpha as if blending in sRGB, then convert it
   with tools/linear-preview/ui_alpha.py. */

.root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: rgb(255, 255, 255); }
.layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.centre { align-items: center; justify-content: center; }
.fade { transition-property: opacity; transition-duration: 0.18s; }
.off { opacity: 0; }
.dimmer { background-color: rgba(0, 0, 0, 0.498); }

/* Glass */
.glass { overflow: hidden; border-width: 1px; border-color: rgba(255, 255, 255, 0.059); border-top-color: rgba(255, 255, 255, 0.11); border-radius: 20px; }
.glass-blur, .glass-sheen { position: absolute; -unity-background-scale-mode: stretch-to-fill; }
/* Dark glass, because all menu text is white: #0c0e0e under the sheen, as dark as 66% blended in sRGB. */
.glass-sheen { left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(12, 14, 14, 0.848); }
.glass-shadow { position: absolute; -unity-background-scale-mode: stretch-to-fill; -unity-slice-left: 32; -unity-slice-right: 32; -unity-slice-top: 32; -unity-slice-bottom: 32; }

/* Top bar */
.top { position: absolute; left: 32px; right: 32px; top: 24px; flex-direction: row; justify-content: space-between; align-items: center; }
.top-team { flex-direction: row; align-items: center; }
.badge { width: 32px; height: 32px; margin-right: 14px; -unity-background-scale-mode: scale-to-fit; }
.top-name { font-size: 16px; letter-spacing: 1.1px; }
.meta { flex-direction: row; align-items: center; height: 46px; padding-left: 22px; padding-right: 22px; }
.year { font-size: 15px; letter-spacing: 0.9px; color: rgba(255, 255, 255, 0.392); margin-right: 18px; }
.money { font-size: 21px; color: rgb(61, 220, 132); }

/* Hub menu: on the hub and beside every panel, the open screen's item lit */
.menu { position: absolute; left: 32px; top: 112px; padding: 10px; }
.layer.centre > .menu { position: relative; left: 0; top: 0; }
.group.spaced { margin-top: 14px; }
.item { width: 272px; height: 40px; padding-left: 16px; padding-right: 16px; border-radius: 12px; font-size: 15px; letter-spacing: 0.9px; -unity-text-align: middle-left; }
.item:hover { background-color: rgba(255, 255, 255, 0.023); }
.item.on { background-color: rgba(255, 255, 255, 0.059); }
.hub-item { padding-left: 50px; }
.item-icon { position: absolute; left: 16px; top: 10px; width: 20px; height: 20px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgba(255, 255, 255, 0.565); }
.item:hover .item-icon, .item.on .item-icon { -unity-background-image-tint-color: rgb(255, 255, 255); }
.item.dim { opacity: 0.35; }
.item.dim:hover { background-color: rgba(0, 0, 0, 0); }

/* The race car's tag in the garage */
.tag { position: absolute; min-width: 250px; padding: 12px 16px; }
.tag-top { flex-direction: row; align-items: center; margin-bottom: 8px; }
.tag-top .cls { margin-right: 10px; }
.tag-name { font-size: 16px; letter-spacing: 0.8px; white-space: nowrap; }
.tag-condition { flex-direction: row; align-items: center; }
.tag-condition > .stat-value { width: auto; }

/* Panels */
.panel { position: absolute; right: 32px; top: 100px; bottom: 32px; width: 620px; border-radius: 24px; padding: 16px; }
.panel-body { flex-grow: 1; }
.back { flex-shrink: 0; margin-bottom: 8px; }
.panel#crew, .panel#new-game { bottom: auto; }
.panel#finances { bottom: auto; max-height: 768px; }
.side { position: absolute; right: 668px; top: 100px; width: 460px; border-radius: 24px; padding: 20px; }
.side-body { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.lineup { position: absolute; right: 40px; bottom: 40px; width: 400px; padding: 10px; }
.lineup-rows { margin-bottom: 10px; }

/* Small caps label over a part of a panel */
.section-label { flex-shrink: 0; margin-bottom: 8px; padding-left: 4px; font-size: 12px; letter-spacing: 1.2px; color: rgba(255, 255, 255, 0.392); }
.block { flex-shrink: 0; margin-bottom: 12px; }

/* Lists: a head row over rows, both padded 12px so heads sit over their cells. Numbers align right, words left. */
.list { flex-grow: 1; flex-shrink: 1; min-height: 0; }
/* The menus run without Unity's default theme, so scroll views get its layout here: the viewport clips and fills the
   view, and the content keeps its full height instead of squeezing its rows to fit. */
.unity-scroll-view__content-viewport { flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.unity-scroll-view__content-container { flex-shrink: 0; }
/* Likewise text fields: the text fills the box and sits in its middle. */
.unity-base-text-field__input { justify-content: center; }
.unity-base-text-field__input .unity-text-element { flex-grow: 1; -unity-text-align: middle-left; }
.head-row { flex-direction: row; align-items: center; flex-shrink: 0; height: 28px; padding-left: 12px; padding-right: 12px; }
.head { flex-shrink: 0; font-size: 13px; letter-spacing: 1.2px; color: rgba(255, 255, 255, 0.194); -unity-text-align: middle-right; white-space: nowrap; }
.head.sort:hover, .stat-head:hover .head { color: rgba(255, 255, 255, 0.565); }
.head.on, .stat-head .head.on { color: rgb(255, 255, 255); }
.stat-head { flex-direction: row; align-items: center; justify-content: flex-end; }
.caret { position: absolute; right: -14px; top: 50%; width: 10px; height: 10px; margin-top: -5px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgba(255, 255, 255, 0.369); }
.row { flex-direction: row; align-items: center; flex-shrink: 0; height: 36px; padding-left: 12px; padding-right: 12px; border-radius: 12px; border-width: 1px; border-color: rgba(255, 255, 255, 0); font-size: 15px; }
.row.click:hover { background-color: rgba(255, 255, 255, 0.023); }
.row.me, .row.me.click:hover, .row.drag { background-color: rgba(255, 255, 255, 0.059); }
.row.on, .row.on.click:hover { background-color: rgba(255, 255, 255, 0.059); border-color: rgba(255, 255, 255, 0.314); }
.row.two-line { height: 54px; align-items: flex-start; padding-top: 7px; }
.row.two-line > .cell { height: 20px; }
.row > .cls { margin-right: 12px; }
.cell { flex-shrink: 0; white-space: nowrap; -unity-text-align: middle-right; }
.fill { flex-grow: 1; flex-shrink: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; -unity-text-align: middle-left; }
.row-icon { width: 18px; height: 18px; margin-right: 14px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgba(255, 255, 255, 0.565); }
.grip { width: 10px; height: 14px; margin-right: 12px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgba(255, 255, 255, 0.219); }
.drag-row:hover .grip { -unity-background-image-tint-color: rgba(255, 255, 255, 0.809); }
.pin { position: absolute; left: 0; right: 0; background-color: rgb(74, 77, 77); }
.pin-top { top: 28px; }
.pin-bottom { bottom: 0; }

/* Columns before the name */
.c-pos { width: 30px; margin-right: 12px; }
.c-place { width: 20px; margin-right: 12px; }
.c-class { width: 24px; margin-right: 12px; }
.c-year { width: 52px; margin-right: 12px; -unity-text-align: middle-left; }
.c-at { width: 36px; margin-right: 16px; }
.c-secs { width: 52px; margin-right: 12px; }
.c-tyre { width: 18px; height: 18px; margin-right: 12px; -unity-background-scale-mode: scale-to-fit; }
.c-fuel { width: 48px; margin-right: 16px; color: rgba(255, 255, 255, 0.392); }
.c-swatch { width: 10px; margin-right: 12px; }
/* Columns after the name */
.c-team { width: 150px; margin-left: 12px; font-size: 13px; color: rgba(255, 255, 255, 0.392); overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; }
.c-age { width: 40px; margin-left: 12px; }
.c-stat { width: 92px; margin-left: 12px; }
.c-salary { width: 86px; margin-left: 12px; }
.c-cond { width: 64px; margin-left: 12px; }
.c-price { width: 96px; margin-left: 12px; }
.c-laps { width: 52px; margin-left: 12px; }
.c-prize { width: 100px; margin-left: 12px; }
.c-overall { width: 44px; margin-left: 12px; color: rgba(255, 255, 255, 0.392); }
.c-prestige { width: 72px; margin-left: 12px; }
.c-change { width: 72px; margin-left: 12px; }
.c-scout { width: 44px; margin-left: 6px; }
.c-ovr { width: 48px; margin-left: 12px; }
.c-class-pos { width: 84px; margin-left: 12px; }
.c-amount { margin-left: 14px; }
.c-range { width: 100px; margin-left: 12px; color: rgba(255, 255, 255, 0.392); }
.c-count { width: 54px; margin-left: 12px; }
.c-lap { width: 90px; margin-left: 12px; color: rgba(255, 255, 255, 0.392); }
.c-fixed { width: 54px; margin-left: 12px; }
.trend { flex-direction: row; align-items: center; justify-content: flex-end; }
.trend-arrow { width: 12px; height: 12px; margin-right: 6px; -unity-background-scale-mode: scale-to-fit; }

/* Teams: flag and name in one line, the car model under it in two */
.team-name { flex-direction: row; align-items: center; min-width: 0; }
.team-name-text { flex-shrink: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.team-lines { min-width: 0; }
.car-name { margin-top: 2px; margin-left: 30px; font-size: 13px; color: rgba(255, 255, 255, 0.392); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.flag { width: 20px; height: 15px; margin-right: 10px; flex-shrink: 0; border-width: 1px; border-color: rgba(255, 255, 255, 0.098); border-radius: 2px; -unity-background-scale-mode: scale-and-crop; }
.flag-lg { width: 32px; height: 24px; margin-right: 14px; border-radius: 3px; }
.team-title { flex-direction: row; align-items: center; flex-shrink: 0; margin-bottom: 8px; }
.team-title > .detail-name { flex-shrink: 1; min-width: 0; white-space: normal; }
.brand-name { flex-direction: row; align-items: center; }
.brand { width: 22px; height: 22px; margin-right: 10px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.brand-name-text { flex-shrink: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.link { cursor: link; }
.link-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.words { flex-direction: row; align-items: center; }
.word { margin-right: 5px; white-space: nowrap; }
.swatch { width: 10px; height: 10px; border-radius: 3px; margin-right: 12px; flex-shrink: 0; }
.who { flex-direction: row; align-items: center; }
.who-name { flex-shrink: 1; min-width: 0; margin-right: 10px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.who-fixed { flex-shrink: 1; min-width: 0; font-size: 13px; color: rgb(255, 176, 32); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* Class labels: the class letter in its colour, boxed in the same colour (ClassLabels.cs) */
.cls { border-width: 1.5px; border-radius: 6px; -unity-text-align: middle-center; flex-shrink: 0; -unity-background-scale-mode: scale-and-crop; }
.cls-sm { width: 24px; height: 21px; font-size: 12px; }
.cls-md { width: 30px; height: 27px; font-size: 15px; }

/* Tabs */
.tabs { flex-direction: row; flex-shrink: 0; margin-bottom: 8px; }
.tab { flex-direction: row; align-items: center; justify-content: center; height: 36px; min-width: 40px; margin-right: 2px; padding-left: 12px; padding-right: 12px; border-radius: 12px; font-size: 14px; letter-spacing: 1.1px; color: rgba(255, 255, 255, 0.392); -unity-text-align: middle-center; }
.tab:hover { background-color: rgba(255, 255, 255, 0.023); color: rgb(255, 255, 255); }
.tab.on { background-color: rgba(255, 255, 255, 0.059); color: rgb(255, 255, 255); }
.tab-class { letter-spacing: 0; }
.tab-end { margin-left: auto; }
.tab-icon { width: 18px; height: 18px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgba(255, 255, 255, 0.565); }
.tab-count { margin-left: 8px; font-size: 14px; letter-spacing: 0; color: rgba(255, 255, 255, 0.194); }
.tab.on .tab-count { color: rgba(255, 255, 255, 0.392); }

/* Steppers: a value between two chevrons. A chevron hides where the value can't go further. */
.stepper { flex-direction: row; align-items: center; flex-shrink: 0; }
.stepper-value { min-width: 84px; font-size: 15px; letter-spacing: 1.2px; -unity-text-align: middle-center; }
.chevron { width: 36px; height: 36px; border-radius: 10px; align-items: center; justify-content: center; }
.chevron:hover { background-color: rgba(255, 255, 255, 0.023); }
.chevron-image { width: 18px; height: 18px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgba(255, 255, 255, 0.565); }
.chevron:hover .chevron-image { -unity-background-image-tint-color: rgb(255, 255, 255); }
.year-stepper { margin-bottom: 8px; }
.settings-stepper { width: 250px; }
.settings-stepper > .stepper-value { flex-grow: 1; letter-spacing: 0.6px; }
.qty-stepper > .chevron { width: 30px; height: 32px; }
.qty-stepper > .stepper-value { min-width: 26px; font-size: 16px; letter-spacing: 0; }

/* Red buttons: a gradient child under the label, clipped to the corners */
.red { overflow: hidden; border-radius: 20px; border-top-width: 1px; border-color: rgba(255, 255, 255, 0.11); border-left-width: 0; border-right-width: 0; border-bottom-width: 0; align-items: center; justify-content: center; }
.red-fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: stretch-to-fill; }
.red:hover .red-fill { -unity-background-image-tint-color: rgb(255, 225, 220); }
.red-label { font-size: 18px; letter-spacing: 2.9px; -unity-text-align: middle-center; }
.red.disabled, .ghost-button.disabled { opacity: 0.35; }
.red.disabled:hover .red-fill { -unity-background-image-tint-color: rgb(255, 255, 255); }
.ghost-button { overflow: hidden; border-radius: 20px; border-width: 1px; border-color: rgba(255, 255, 255, 0.142); align-items: center; justify-content: center; }
.ghost-button:hover { background-color: rgba(255, 255, 255, 0.023); }
.ghost-label { font-size: 18px; letter-spacing: 2.9px; -unity-text-align: middle-center; }
.panel-button { height: 52px; flex-shrink: 0; }
.big-button { height: 62px; flex-shrink: 0; padding-left: 54px; padding-right: 54px; }
.big-button .red-label { font-size: 22px; letter-spacing: 3.5px; }
.corner { position: absolute; right: 40px; bottom: 40px; }
.small-button { flex-direction: row; align-items: center; justify-content: center; height: 36px; padding-left: 14px; padding-right: 14px; border-radius: 12px; background-color: rgba(255, 255, 255, 0.023); border-width: 1px; border-color: rgba(255, 255, 255, 0.035); }
.small-button:hover { background-color: rgba(255, 255, 255, 0.05); }
.small-button.disabled { opacity: 0.35; }
.small-button.disabled:hover { background-color: rgba(255, 255, 255, 0.023); }
.small-label { font-size: 14px; letter-spacing: 0.8px; -unity-text-align: middle-center; }
.small-money { margin-left: 6px; font-size: 14px; color: rgb(61, 220, 132); }

/* Tiles: a small caps label over a value, a count or a button */
.tiles { flex-direction: row; flex-shrink: 0; margin-bottom: 12px; }
.tiles > .tile, .roster > .tile { flex-grow: 1; flex-basis: 0; margin-right: 8px; }
.tiles > .tile.last, .roster > .tile.last { margin-right: 0; }
.tile { flex-shrink: 0; padding: 10px 12px; border-radius: 12px; background-color: rgba(255, 255, 255, 0.012); border-width: 1px; border-color: rgba(255, 255, 255, 0); }
.tile.click:hover { background-color: rgba(255, 255, 255, 0.023); }
.tile.on, .tile.on.click:hover { background-color: rgba(255, 255, 255, 0.059); border-color: rgba(255, 255, 255, 0.314); }
.tile.got { background-color: rgba(255, 255, 255, 0.035); }
.tile.pv { border-color: rgba(255, 255, 255, 0.142); }
.tile-head { flex-direction: row; align-items: center; justify-content: space-between; min-height: 22px; }
.tile-label { font-size: 12px; letter-spacing: 1.2px; color: rgba(255, 255, 255, 0.392); white-space: nowrap; }
.tile-value { margin-top: 2px; font-size: 22px; }
.tile-count { font-size: 20px; }
.tile-price { font-size: 15px; color: rgba(255, 255, 255, 0.55); }
.tile-line { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 6px; }
.tile-line > .small-button { flex-grow: 1; margin-left: 10px; }
.tile > .small-button { margin-top: 8px; }
.tile.preview .tile-value { opacity: 0.55; }
.tick { width: 22px; height: 22px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(61, 220, 132); }
.inset { flex-shrink: 0; margin-bottom: 12px; padding: 16px; border-radius: 20px; background-color: rgba(0, 0, 0, 0.343); }
.pips { flex-direction: row; align-items: center; }
.pip { width: 6px; height: 6px; border-radius: 3px; margin-left: 4px; background-color: rgb(255, 255, 255); }

/* Stats: a name that explains itself on hover, a 0 to 100 bar, the value, and sometimes a change */
.stats { flex-shrink: 0; margin-bottom: 14px; }
.stat-row { flex-direction: row; align-items: center; height: 22px; margin-bottom: 4px; }
.stat-label { width: 150px; margin-right: 12px; font-size: 12px; letter-spacing: 1.2px; color: rgba(255, 255, 255, 0.392); }
.stat-bar { flex-grow: 1; height: 6px; border-radius: 9px; overflow: hidden; background-color: rgba(255, 255, 255, 0.039); }
.stat-fill { height: 100%; border-radius: 9px; }
.stat-ghost { position: absolute; top: 0; bottom: 0; border-top-right-radius: 9px; border-bottom-right-radius: 9px; background-color: rgba(255, 255, 255, 0.068); }
.stat-ghost.lit { background-color: rgba(255, 255, 255, 0.314); }
.stat-value { width: 40px; margin-left: 12px; font-size: 15px; -unity-text-align: middle-right; }
.stat-delta { width: 40px; margin-left: 12px; font-size: 13px; -unity-text-align: middle-right; }
.condition { margin-bottom: 8px; }
.repair { flex-direction: row; align-items: center; justify-content: flex-end; }
.repair > .small-button { margin-left: 4px; }
.tag .stat-bar { height: 5px; margin-right: 10px; }

/* A side pane's or a car's heading: the name, a line of details under it, and a big figure on the right */
.detail { flex-shrink: 0; }
.detail-head { flex-direction: row; justify-content: space-between; align-items: flex-end; flex-shrink: 0; margin-bottom: 14px; }
.detail-name { font-size: 26px; letter-spacing: 1px; }
.detail-meta { flex-direction: row; align-items: center; flex-shrink: 0; margin-top: 6px; margin-bottom: 8px; }
.detail-meta > .cls { margin-right: 10px; }
.detail-car { margin-right: 16px; font-size: 16px; }
.meta-item { margin-right: 16px; font-size: 14px; letter-spacing: 0.8px; color: rgba(255, 255, 255, 0.392); }
.detail-big { font-size: 46px; -unity-text-align: lower-right; }
.detail-right { align-items: flex-end; }
.detail-right > .meta-item { margin-right: 0; margin-top: 2px; }
.detail-price { font-size: 28px; -unity-text-align: middle-right; }

/* Popups: lists that open over everything, on the popup layer */
.popup { position: absolute; padding: 6px; border-radius: 12px; background-color: rgba(24, 24, 26, 0.978); border-width: 1px; border-color: rgba(255, 255, 255, 0.035); }
.popup-list { flex-shrink: 1; }
.popup-item { height: 32px; flex-shrink: 0; padding-left: 12px; padding-right: 12px; border-radius: 8px; font-size: 14px; letter-spacing: 0.6px; color: rgba(255, 255, 255, 0.565); -unity-text-align: middle-left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.popup-item:hover, .popup-item.on { color: rgb(255, 255, 255); }
.popup-item:hover { background-color: rgba(255, 255, 255, 0.023); }
.popup-item.on { background-color: rgba(255, 255, 255, 0.059); }

/* Dropdowns: a value between a spacer and a down chevron, the size of a stepper, opening a popup list of every choice */
.dropdown { flex-direction: row; align-items: center; flex-shrink: 0; border-radius: 10px; }
.dropdown:hover, .dropdown.open { background-color: rgba(255, 255, 255, 0.023); }
.dropdown-side { width: 36px; height: 36px; align-items: center; justify-content: center; }
.dropdown-chevron { width: 18px; height: 18px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgba(255, 255, 255, 0.565); }
.dropdown:hover .dropdown-chevron, .dropdown.open .dropdown-chevron { -unity-background-image-tint-color: rgb(255, 255, 255); }
.dropdown-value { flex-grow: 1; font-size: 15px; letter-spacing: 0.6px; -unity-text-align: middle-center; }
.settings-dropdown { width: 250px; }
.dropdown-list { background-color: rgb(24, 24, 26); }
.dropdown-list > .popup-list { min-height: 0; }
.dropdown-list .popup-item { -unity-text-align: middle-center; }

/* Tooltips: only on stats and skills */
.tip { position: absolute; max-width: 260px; padding: 10px 14px; border-radius: 12px; font-size: 14px; white-space: normal; background-color: rgba(20, 20, 22, 0.973); border-width: 1px; border-color: rgba(255, 255, 255, 0.035); }

/* Dialogs: over whatever is showing, Cancel and a red confirm */
.dialog { width: 420px; border-radius: 24px; padding: 16px; }
.dialog-body { padding: 8px 6px 16px 6px; }
.dialog-title { font-size: 20px; letter-spacing: 1px; }
.dialog-sub { font-size: 14px; letter-spacing: 0.8px; color: rgba(255, 255, 255, 0.392); }
.dialog-career { flex-direction: row; align-items: center; }
.dialog-badge { width: 44px; height: 44px; margin-right: 14px; -unity-background-scale-mode: scale-to-fit; }
.dialog-buttons { flex-direction: row; }
.dialog-button { flex-grow: 1; flex-basis: 0; height: 52px; margin-right: 8px; }
.dialog-button.last { margin-right: 0; }

/* Main menu: a tall glass column on the left edge */
.main-column { position: absolute; left: 0; top: 0; bottom: 0; width: 470px; border-left-width: 0; border-top-left-radius: 0; border-bottom-left-radius: 0; border-top-right-radius: 28px; border-bottom-right-radius: 28px; padding: 110px 56px; }
.wordmark { width: 358px; height: 209.32px; margin-bottom: 80px; overflow: hidden; flex-shrink: 0; }
.wordmark-layer { position: absolute; -unity-background-scale-mode: stretch-to-fill; }
.wordmark-car { position: absolute; }
.main-item { height: auto; padding: 12px 18px; margin-left: -18px; border-radius: 14px; font-size: 24px; letter-spacing: 0; }
.main-item:hover { background-color: rgba(255, 255, 255, 0.059); }
.main-item .label { font-size: 24px; }
.build-stamp { position: absolute; left: 56px; bottom: 40px; font-size: 14px; color: rgba(255, 255, 255, 0.392); }
.main-item .sub { font-size: 14px; color: rgba(255, 255, 255, 0.392); margin-top: 2px; }

/* Settings */
.settings { width: 560px; max-height: 92%; border-radius: 24px; padding: 16px; }
.settings-scroll { flex-shrink: 1; min-height: 0; }
.settings-group { flex-shrink: 0; }
.settings-group.spaced { margin-top: 22px; }
.setting { flex-direction: row; align-items: center; flex-shrink: 0; height: 44px; padding-left: 16px; padding-right: 6px; border-radius: 12px; }
.setting:hover { background-color: rgba(255, 255, 255, 0.023); }
.setting-label { flex-grow: 1; font-size: 14px; letter-spacing: 1.1px; color: rgba(255, 255, 255, 0.392); }
.slider { width: 250px; flex-direction: row; align-items: center; padding-right: 10px; }
.track { flex-grow: 1; height: 34px; justify-content: center; margin-right: 12px; }
.track-line { height: 6px; border-radius: 9px; background-color: rgba(255, 255, 255, 0.039); }
.track-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 9px; background-color: rgb(255, 255, 255); }
.knob { position: absolute; top: 9px; width: 16px; height: 16px; margin-left: -8px; border-radius: 8px; background-color: rgb(255, 255, 255); }
.slider-value { width: 32px; font-size: 15px; -unity-text-align: middle-right; }
.slider-value.wide { width: 46px; }
.settings-reset { width: 250px; height: 36px; }
/* The race's pause menu holds the camera tuner at the right edge, clear of the car in the middle of the screen.
   Its own class: .side is the Team HQ side pane, and a shared name squeezed that pane's tables into one column. */
.right-edge { align-items: flex-end; justify-content: center; padding-right: 32px; }
.camera-settings { width: 460px; }
.settings-reset > .ghost-label { font-size: 14px; letter-spacing: 1.1px; }

/* Skill points: pips for the points left, then each skill between a minus and a plus */
.skills { flex-shrink: 0; }
.skill-pips { flex-direction: row; justify-content: center; margin-bottom: 10px; }
.skill-pip { width: 10px; height: 10px; margin-left: 3.5px; margin-right: 3.5px; border-radius: 5px; background-color: rgb(255, 255, 255); border-width: 1.5px; border-color: rgb(255, 255, 255); }
.skill-pip.used { background-color: rgba(255, 255, 255, 0); border-color: rgba(255, 255, 255, 0.11); }
.skill-line { flex-direction: row; }
.skill { flex-grow: 1; flex-basis: 0; align-items: center; }
.skill-name { margin-bottom: 4px; font-size: 12px; letter-spacing: 1.2px; color: rgba(255, 255, 255, 0.392); }
.skill-level { flex-direction: row; align-items: center; }
.skill-value { min-width: 38px; font-size: 28px; -unity-text-align: middle-center; }
.skill-step { width: 28px; height: 28px; border-radius: 9px; align-items: center; justify-content: center; background-color: rgba(255, 255, 255, 0.035); }
.skill-step:hover { background-color: rgba(255, 255, 255, 0.088); }
.skill-step-icon { width: 14px; height: 14px; -unity-background-scale-mode: scale-to-fit; }

/* One race, in the race summary and the race history (RaceView.cs) */
.podium { flex-direction: row; flex-shrink: 0; margin-bottom: 14px; }
.podium-class { width: 44px; height: 34px; font-size: 30px; -unity-text-align: middle-center; }
.podium-rows { flex-grow: 1; }
.hero { flex-direction: row; align-items: center; flex-shrink: 0; margin-bottom: 14px; }
.hero-pos { font-size: 52px; margin-right: 24px; }
.hero-class { flex-direction: row; align-items: center; margin-right: 24px; }
.hero-class-pos { margin-left: 8px; font-size: 20px; }
.hero-figure { margin-right: 24px; }
.hero-value { font-size: 20px; }
.hero-label { margin-top: -2px; font-size: 12px; letter-spacing: 1.2px; color: rgba(255, 255, 255, 0.392); }
.hero-prize { margin-left: auto; font-size: 22px; }
.chart { flex-shrink: 0; height: 190px; margin-bottom: 10px; }
.chart-plot { flex-grow: 1; }
.chart-axis { position: absolute; height: 16px; font-size: 12px; letter-spacing: 0.7px; color: rgba(255, 255, 255, 0.194); }
.chart-readout { position: absolute; top: -4px; right: 0; font-size: 14px; }
.legend { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; margin-bottom: 8px; }
.legend-item { flex-direction: row; align-items: center; margin-right: 16px; margin-bottom: 4px; }
.legend-item > .swatch { width: 12px; height: 12px; margin-right: 8px; }
.legend-text { font-size: 14px; color: rgba(255, 255, 255, 0.392); }
.legend-dot { width: 11px; height: 11px; margin-right: 8px; border-radius: 6px; background-color: rgb(255, 176, 32); }
.legend-tick { width: 2px; height: 16px; margin-right: 8px; margin-left: 3px; background-color: rgba(255, 255, 255, 0.722); }
.history-log { flex-grow: 1; flex-shrink: 1; min-height: 0; max-height: 300px; }

/* Race summary: results left, the player's race right, the car in its box between */
.summary-results { position: absolute; left: 32px; top: 100px; bottom: 32px; width: 520px; border-radius: 24px; padding: 12px; }
.summary-side { position: absolute; left: 908px; right: 32px; top: 100px; bottom: 164px; }
.summary-box { flex-shrink: 0; margin-bottom: 16px; padding: 14px 20px; }
.summary-box > .hero, .summary-box > .legend { margin-bottom: 0; }
.summary-log { flex-grow: 1; min-height: 0; padding: 12px; }
.summary-skills { position: absolute; left: 908px; bottom: 32px; width: 420px; height: 116px; padding: 10px 16px; justify-content: center; }

/* Drivers */
.roster { flex-direction: row; flex-shrink: 0; margin-bottom: 12px; }
.slot { min-height: 66px; justify-content: center; }
.slot:hover { background-color: rgba(255, 255, 255, 0.023); }
.slot.empty, .slot.empty:hover { background-color: rgba(255, 255, 255, 0); border-color: rgba(255, 255, 255, 0.059); }
.slot.drag { opacity: 0.4; }
.slot.over { border-color: rgba(255, 255, 255, 0.494); }
.slot-name { flex-shrink: 1; min-width: 0; font-size: 14px; letter-spacing: 0.6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.slot .grip { margin-left: auto; margin-right: 0; }
.slot:hover .grip { -unity-background-image-tint-color: rgba(255, 255, 255, 0.809); }
.tools { flex-direction: row; flex-shrink: 0; margin-bottom: 6px; }
.search { flex-grow: 1; flex-direction: row; align-items: center; height: 40px; padding-left: 14px; padding-right: 8px; border-radius: 12px; background-color: rgba(255, 255, 255, 0.017); }
.search-icon { width: 16px; height: 16px; margin-right: 10px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgba(255, 255, 255, 0.369); }
.search-field { flex-grow: 1; margin: 0; padding: 0; }
.search-field .unity-base-text-field__input { flex-grow: 1; margin: 0; padding: 0; border-width: 0; background-color: rgba(0, 0, 0, 0); font-size: 15px; color: rgb(255, 255, 255); --unity-cursor-color: rgb(255, 255, 255); --unity-selection-color: rgba(255, 255, 255, 0.11); }
.chip { height: 40px; margin-left: 8px; padding-left: 16px; padding-right: 16px; border-radius: 12px; border-width: 1px; border-color: rgba(255, 255, 255, 0.035); font-size: 13px; letter-spacing: 1.3px; color: rgba(255, 255, 255, 0.392); -unity-text-align: middle-center; }
.chip:hover { background-color: rgba(255, 255, 255, 0.017); }
.chip.on { background-color: rgba(255, 255, 255, 0.059); border-color: rgba(255, 255, 255, 0.314); color: rgb(255, 255, 255); }

/* Crew */
.crew-head { align-items: flex-end; margin-bottom: 12px; padding-left: 4px; padding-right: 4px; }
.crew-head.preview > .detail-big, .crew-head.preview > .detail-price { opacity: 0.55; }
.crew-action { flex-grow: 1; margin-left: 16px; margin-bottom: 4px; font-size: 14px; letter-spacing: 1.1px; }
.crew-grid { margin-bottom: 4px; }
.crew-row { flex-direction: row; margin-bottom: 8px; }
.member { width: 66px; height: 66px; margin-right: 8px; border-radius: 12px; align-items: center; justify-content: center; border-width: 1px; border-color: rgba(255, 255, 255, 0.068); }
.member.last { margin-right: 0; }
.member-image { width: 30px; height: 30px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgba(255, 255, 255, 0.11); }
.member.in { background-color: rgba(255, 255, 255, 0.059); border-color: rgba(255, 255, 255, 0); }
.member.in .member-image { -unity-background-image-tint-color: rgb(255, 255, 255); }
.member.adding { background-color: rgba(255, 255, 255, 0.017); }
.member.adding .member-image { -unity-background-image-tint-color: rgba(255, 255, 255, 0.494); }
.member.leaving { background-color: rgba(255, 255, 255, 0.023); }
.member.leaving .member-image { -unity-background-image-tint-color: rgba(255, 255, 255, 0.314); }
.member.disabled { opacity: 0.35; }

/* Finances: the prize money table in the side pane */
.prizes { flex-direction: row; }
.prize-col { flex-grow: 1; flex-basis: 0; margin-right: 6px; }
.prize-col.last { margin-right: 0; }
.prize-cell { flex-direction: row; align-items: center; height: 26px; padding-left: 8px; padding-right: 8px; border-radius: 8px; font-size: 13px; }
.prize-cell.me { background-color: rgba(255, 255, 255, 0.059); }
.prize-pos { width: 22px; margin-right: 6px; white-space: nowrap; color: rgba(255, 255, 255, 0.194); }
.prize-cell.me .prize-pos { color: rgb(255, 255, 255); }
.prize-amount { flex-grow: 1; white-space: nowrap; -unity-text-align: middle-right; }

/* Garage: the car workshop and both dealers (WorkshopPanel.cs, DealerPanel.cs, GarageUi.cs) */
.frame { flex-grow: 1; min-height: 0; }
.frame-foot { flex-direction: row; flex-shrink: 0; margin-top: 4px; }
.frame-foot > .red, .frame-foot > .selected, .frame-foot > .notice { flex-grow: 1; }
.car-head { flex-direction: row; align-items: center; flex-shrink: 0; margin-bottom: 12px; }
.car-head-mid { flex-grow: 1; align-items: center; }
.car-head-mid > .detail-name { -unity-text-align: middle-center; }
.car-head-mid > .detail-meta { margin-bottom: 0; }
.dots { flex-direction: row; align-items: center; }
.dot { width: 8px; height: 8px; margin-right: 6px; border-radius: 6px; background-color: rgba(255, 255, 255, 0.098); }
.dot.on { background-color: rgb(255, 255, 255); }
.dot.rc { width: 12px; height: 12px; margin-left: -2px; margin-right: 4px; border-width: 2px; border-color: rgb(225, 6, 0); }
.selected { flex-direction: row; align-items: center; justify-content: center; height: 52px; border-radius: 20px; background-color: rgba(225, 6, 0, 0.298); border-width: 1px; border-color: rgba(255, 80, 70, 0.689); }
.selected-icon { width: 24px; height: 24px; margin-right: 10px; -unity-background-scale-mode: scale-to-fit; }
.selected-label { font-size: 18px; letter-spacing: 2.9px; }
.sell { width: 250px; height: 52px; flex-shrink: 0; margin-left: 12px; }
.sell > .ghost-label { font-size: 15px; letter-spacing: 1.5px; }
.sell-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; -unity-background-scale-mode: stretch-to-fill; }
.notice { height: 52px; justify-content: center; align-items: center; border-radius: 20px; border-width: 1px; border-color: rgba(255, 90, 79, 0.431); background-color: rgba(255, 90, 79, 0.061); }
.notice-label { font-size: 18px; letter-spacing: 2.9px; }

/* New game: one panel that fits its content */
.ng-team { flex-direction: row; }
.ng-big { width: 120px; height: 120px; flex-shrink: 0; margin-right: 16px; border-radius: 16px; align-items: center; justify-content: center; background-color: rgba(255, 255, 255, 0.012); }
.ng-big-badge { width: 84px; height: 84px; -unity-background-scale-mode: scale-to-fit; }
.ng-team-column { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.ng-field { margin: 0; padding: 0; height: 44px; }
.ng-field .unity-base-text-field__input { flex-grow: 1; margin: 0; padding-left: 14px; padding-right: 14px; border-radius: 12px; border-width: 1px; border-color: rgba(255, 255, 255, 0); background-color: rgba(255, 255, 255, 0.017); font-size: 16px; color: rgb(255, 255, 255); -unity-text-align: middle-left; --unity-cursor-color: rgb(255, 255, 255); --unity-selection-color: rgba(255, 255, 255, 0.11); }
.ng-field:focus .unity-base-text-field__input { border-color: rgba(255, 255, 255, 0.178); }
.ng-field .unity-base-text-field__input--placeholder { font-size: 14px; letter-spacing: 1.4px; color: rgba(255, 255, 255, 0.194); }
.ng-team-name { height: 48px; margin-bottom: 10px; }
.ng-team-name .unity-base-text-field__input { font-size: 20px; }
.ng-shapes { flex-direction: row; justify-content: space-between; margin-bottom: 10px; }
.ng-shape { width: 44px; height: 44px; border-radius: 10px; align-items: center; justify-content: center; }
.ng-shape:hover { background-color: rgba(255, 255, 255, 0.023); }
.ng-shape.on { background-color: rgba(255, 255, 255, 0.059); }
.ng-shape-image { width: 24px; height: 24px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgba(255, 255, 255, 0.494); }
.ng-shape.on .ng-shape-image, .ng-shape:hover .ng-shape-image { -unity-background-image-tint-color: rgb(255, 255, 255); }
.ng-colours { flex-direction: row; justify-content: space-between; padding-left: 2px; padding-right: 2px; }
.ng-swatch { width: 36px; height: 36px; border-radius: 18px; border-width: 2px; border-color: rgba(255, 255, 255, 0); align-items: center; justify-content: center; }
.ng-swatch.on { border-color: rgb(255, 255, 255); }
.ng-swatch-fill { width: 26px; height: 26px; border-radius: 13px; border-width: 1px; border-color: rgba(255, 255, 255, 0.082); }
.ng-player { flex-direction: row; padding: 12px; }
.ng-half { flex-grow: 1; flex-basis: 0; margin-right: 8px; }
.ng-half.last { margin-right: 0; }
.ng-countries { max-height: 280px; }

/* Newspaper: a broadsheet on a 1600 x 900 sheet, scaled to fit (NewspaperView.cs). Fonts and ink are set from code. */
.np-page { position: absolute; overflow: hidden; }
.np-sheet { position: absolute; padding: 34px 54px 30px 54px; flex-direction: column; }
.np-mast { align-items: stretch; }
.np-masthead { height: 128px; margin-bottom: 12px; -unity-background-scale-mode: scale-to-fit; }
.np-thick { height: 6px; margin-bottom: 3px; background-color: rgb(18, 18, 18); }
.np-rule { height: 1px; background-color: rgb(18, 18, 18); }
.np-double { height: 5px; border-top-width: 1px; border-bottom-width: 1px; border-color: rgb(18, 18, 18); }
.np-dateline { font-size: 15px; letter-spacing: 3.6px; padding: 8px 0 6px 0; -unity-text-align: middle-center; }
.np-grid { flex-grow: 1; flex-direction: column; padding-top: 18px; overflow: hidden; }
.np-row { flex-direction: row; }
.np-fill { flex-grow: 1; }
.np-cell { flex-direction: column; overflow: hidden; }
.np-ruled { border-left-width: 1px; border-color: rgb(18, 18, 18); margin-left: 15px; padding-left: 15px; }
.np-top { border-bottom-width: 1px; border-color: rgb(18, 18, 18); padding-bottom: 20px; margin-bottom: 20px; }
.np-h1 { font-size: 66px; white-space: normal; margin-bottom: 10px; }
.np-h2 { font-size: 40px; white-space: normal; margin-bottom: 8px; }
.np-h3 { font-size: 32px; white-space: normal; margin-bottom: 8px; }
.np-stand { font-size: 25px; white-space: normal; margin-bottom: 14px; }
.np-cols { flex-direction: row; }
.np-col { flex-grow: 1; flex-basis: 0; }
.np-col-ruled { border-left-width: 1px; margin-left: 12px; padding-left: 12px; }
.np-p { font-size: 20px; white-space: normal; margin-bottom: 8px; }
.np-pods { flex-direction: row; flex-wrap: wrap; margin-right: -24px; }
.np-pod { padding-right: 24px; margin-bottom: 20px; }
.np-pod-class { font-size: 15px; letter-spacing: 3.3px; border-bottom-width: 1px; border-color: rgb(18, 18, 18); padding-bottom: 4px; margin-bottom: 4px; }
.np-pod-row { flex-direction: row; }
.np-pod-place { width: 26px; font-size: 18px; }
.np-pod-team { flex-grow: 1; flex-shrink: 1; font-size: 18px; white-space: normal; }
.np-pod-laps { font-size: 18px; margin-left: 8px; }
.np-pods-wide .np-pod { margin-bottom: 0; }
.np-pods-wide .np-pod-place, .np-pods-wide .np-pod-team, .np-pods-wide .np-pod-laps { font-size: 16px; }
.np-strip { border-top-width: 1px; border-color: rgb(18, 18, 18); padding-top: 14px; margin-top: 14px; }
.np-front .np-h1 { font-size: 54px; }
.np-front .np-h2 { font-size: 34px; }
.np-front .np-h3 { font-size: 28px; }
.np-front .np-stand { font-size: 21px; margin-bottom: 10px; }
.np-front .np-p { font-size: 18px; }
.np-front .np-top { padding-bottom: 14px; margin-bottom: 14px; }
.np-brief { border-top-width: 1px; border-color: rgb(18, 18, 18); margin-top: 10px; padding-top: 9px; }
.np-brief-text { font-size: 20px; -unity-text-align: middle-center; white-space: normal; }
.np-close { position: absolute; right: 24px; top: 24px; width: 48px; height: 48px; border-radius: 24px; align-items: center; justify-content: center; }
.np-close:hover { background-color: rgba(255, 255, 255, 0.023); }
.np-close-icon { width: 18px; height: 18px; -unity-background-scale-mode: scale-to-fit; }

/* Text colours, last so they win over the columns. Good to bad: green at 60 or more, amber from 50, red below.
   v- colours text and icons, f- colours a fill. */
.row.out > .cell, .row.out .team-name-text { color: rgba(255, 255, 255, 0.194); }
.dim, .row.out > .dim { color: rgba(255, 255, 255, 0.194); }
.v-hi, .row.out > .v-hi { color: rgb(61, 220, 132); -unity-background-image-tint-color: rgb(61, 220, 132); }
.v-mid, .row.out > .v-mid { color: rgb(255, 176, 32); -unity-background-image-tint-color: rgb(255, 176, 32); }
.v-lo, .row.out > .v-lo { color: rgb(255, 90, 79); -unity-background-image-tint-color: rgb(255, 90, 79); }
.f-hi { background-color: rgb(61, 220, 132); }
.f-mid { background-color: rgb(255, 176, 32); }
.f-lo { background-color: rgb(255, 90, 79); }
.best, .c-lap.best { color: rgb(197, 140, 255); }
.p1 { color: rgb(232, 193, 90); }
.p2 { color: rgb(201, 208, 214); }
.p3 { color: rgb(200, 138, 86); }
