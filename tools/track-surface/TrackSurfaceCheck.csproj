<Project Sdk="Microsoft.NET.Sdk">
  <!-- Makes the track surface's textures and racing line map with the game's own code outside Unity, checks them and writes previews. Run through run.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../out/track-surface/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Check.cs;Stubs.cs;../circuit/geometry-check/UnityStubs.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/Circuit.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/CircuitData.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/CircuitBuilder.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/CircuitPart.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/MeshKit.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/PitComplex.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/RacingLine.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/CarSpec.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/SpeedProfile.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/TrackTextures.cs" />
    <Compile Include="../../unity/Assets/Simulation/**/*.cs" />
  </ItemGroup>
</Project>
