<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs full careers of driven races outside Unity and reports how many cars finish, and why the rest retire. Run through run.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../out/retirement-check/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Check.cs" />
    <Compile Include="../../unity/Assets/Simulation/**/*.cs" />
  </ItemGroup>
</Project>
