<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the circuit, its stands, the pit complex and the floodlights outside Unity, checks the floodlights and writes the night preview's data. Run through run.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../out/night-lights/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Check.cs;Budget.cs;Preview.cs;Stubs.cs" />
    <Compile Include="../circuit/geometry-check/UnityStubs.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/Circuit.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/CircuitData.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/CircuitBuilder.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/CircuitPart.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/MeshKit.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/Grandstands.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/PitComplex.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/PitComplexBuilder.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/PitBoxKit.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/Floodlights.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/FloodField.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/Furniture/TrackFurniture.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/Furniture/FurnitureBuilder.cs" />
    <Compile Include="../furniture-check/Stubs.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/NightLook.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/SkyClock.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/WeatherSky.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/RaceWeather.cs" />
    <Compile Include="../../unity/Assets/Rendering/Scripts/LinearLight.cs" />
    <Compile Include="../../unity/Assets/Rendering/Scripts/LightFalloff.cs" />
    <None Include="preview.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
