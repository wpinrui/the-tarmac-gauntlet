<Project Sdk="Microsoft.NET.Sdk">
  <!-- Drives the cars' reflection probes' plan (ProbePlan) round the lap with the full field. Run through run.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../out/reflection-check/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Check.cs" />
    <Compile Include="../circuit/geometry-check/UnityStubs.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/Circuit.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/CircuitData.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/ProbePlan.cs" />
  </ItemGroup>
</Project>
