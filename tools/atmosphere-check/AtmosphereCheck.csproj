<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks the cloud map, the cloud shadows, the volumetric clouds' noise and the grade as the sun breaks through, outside Unity. Run through run.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../out/atmosphere-check/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Check.cs;Stubs.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/SkyClock.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/CloudMap.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/SkyGrade.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/Night/NightBudget.cs" />
    <Compile Include="../../unity/Assets/Rendering/Scripts/LinearLight.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/WeatherSky.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/RaceWeather.cs" />
    <Compile Include="../../unity/Assets/Rendering/Scripts/CloudNoise.cs" />
    <Compile Include="../../unity/Assets/Rendering/Scripts/CloudLook.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/SkyPalette.cs" />
  </ItemGroup>
</Project>
