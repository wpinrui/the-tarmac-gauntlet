<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the circuit and its grandstands outside Unity, checks them and writes the preview's data. Run through run.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../out/grandstands/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Check.cs;Stubs.cs" />
    <Compile Include="../circuit/geometry-check/UnityStubs.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/Circuit.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/CircuitData.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/CircuitBuilder.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/CircuitPart.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/MeshKit.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/Grandstands.cs" />
    <None Include="preview.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
