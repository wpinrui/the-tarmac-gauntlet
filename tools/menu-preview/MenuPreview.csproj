<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs the management menu scripts outside Unity against stand-ins for UnityEngine (Stubs/), and writes each
    screen as HTML. ScriptsDir picks which copy of the scripts to build, so two checkouts can be compared.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>MenuPreview</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0067;CS0414;CS0649;CS0169;CS8632</NoWarn>
    <ScriptsDir Condition="'$(ScriptsDir)' == ''">../../unity/Assets/Management/Scripts</ScriptsDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs;Stubs/*.cs" />
    <Compile Include="$(ScriptsDir)/*.cs" Exclude="$(ScriptsDir)/HqDebugMenu.cs;$(ScriptsDir)/RacePauseMenu.cs;$(ScriptsDir)/MenuGlass.cs;$(ScriptsDir)/GarageBays.cs;$(ScriptsDir)/NewspaperView.cs;$(ScriptsDir)/PositionChart.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../unity/dotnet/TarmacGauntlet.Career/TarmacGauntlet.Career.csproj" />
  </ItemGroup>
</Project>
