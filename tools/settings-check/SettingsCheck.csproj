<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the game's settings code outside Unity across two launches and checks every setting is remembered. Run through run.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0067</NoWarn>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../out/settings-check/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Check.cs;Stubs.cs" />
    <Compile Include="../../unity/Assets/Audio/Scripts/Mix.cs" />
    <Compile Include="../../unity/Assets/Visuals/GraphicsOption.cs" />
    <Compile Include="../../unity/Assets/Visuals/GraphicsOptions.cs" />
    <Compile Include="../../unity/Assets/Visuals/GraphicsRow.cs" />
    <Compile Include="../../unity/Assets/Rendering/Scripts/QualityLevels.cs" />
    <Compile Include="../../unity/Assets/Management/Scripts/GameSettings.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/DriveSettings.cs" />
  </ItemGroup>
</Project>
