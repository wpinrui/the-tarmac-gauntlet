<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks the sun path and sky colours outside Unity. Run through run.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../out/sky-check/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Check.cs;Stubs.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/SkyClock.cs" />
  </ItemGroup>
</Project>
