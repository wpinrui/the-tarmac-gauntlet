<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the menus' UI sound rules outside Unity. Run through run.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../out/ui-sounds-check/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Check.cs" />
    <Compile Include="../../unity/Assets/Management/Scripts/MenuSoundRules.cs" />
  </ItemGroup>
</Project>
