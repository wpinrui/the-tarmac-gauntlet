<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the circuit with the game's own builder outside Unity and checks its geometry. Run through run.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../../out/geometry-check/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Check.cs;MoreRules.cs;UnityStubs.cs" />
    <Compile Include="../../../unity/Assets/Raceday/Scripts/Circuit.cs" />
    <Compile Include="../../../unity/Assets/Raceday/Scripts/CircuitData.cs" />
    <Compile Include="../../../unity/Assets/Raceday/Scripts/CircuitBuilder.cs" />
    <Compile Include="../../../unity/Assets/Raceday/Scripts/CircuitPart.cs" />
    <Compile Include="../../../unity/Assets/Raceday/Scripts/MeshKit.cs" />
    <Compile Include="../../../unity/Assets/Raceday/Scripts/PitComplex.cs" />
  </ItemGroup>
</Project>
