<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks the proximity arrows' levels and bearings, outside Unity. Run through run.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../out/proximity-check/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Check.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/Proximity.cs" />
  </ItemGroup>
</Project>
