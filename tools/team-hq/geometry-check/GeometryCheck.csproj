<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the team building with the game's own builder outside Unity, checks it and writes an OBJ to look at. Run through run.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../../out/team-hq-check/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Check.cs" />
    <Compile Include="BakeScene.cs" />
    <Compile Include="../../circuit/geometry-check/UnityStubs.cs" />
    <Compile Include="../../../unity/Assets/TeamHq/Scripts/HqGeometry.cs" />
    <Compile Include="../../../unity/Assets/TeamHq/Scripts/HqLightmapLayout.cs" />
    <Compile Include="../../../unity/Assets/TeamHq/Scripts/HqLighting.cs" />
  </ItemGroup>
</Project>
