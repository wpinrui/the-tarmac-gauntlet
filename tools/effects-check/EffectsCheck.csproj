<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the brake discs' heat for every car outside Unity and checks they glow when they should, and that tyres smoke only on a held slide. Run through run.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../out/effects-check/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Check.cs;Stubs.cs;../circuit/geometry-check/UnityStubs.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/BrakeHeat.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/TyreSmoke.cs" />
    <Compile Include="../../unity/Assets/Raceday/Scripts/CarSpec.cs" />
    <Compile Include="../../unity/Assets/Simulation/**/*.cs" />
  </ItemGroup>
</Project>
